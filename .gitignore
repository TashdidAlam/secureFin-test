# =============================================================================
# SecureFin Platform — .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
# Local .terraform directories (providers, plugins — 700MB+)
.terraform/

# State files (sensitive — stored in Azure Blob Storage backend)
*.tfstate
*.tfstate.*

# Plan output files (may contain sensitive planned values)
*.tfplan
tfplan

# Crash log files
crash.log
crash.*.log

# Override files (local-only overrides, not for version control)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock info (transient, created during apply)
.terraform.tfstate.lock.info

# CLI configuration files
.terraformrc
terraform.rc

# WHY NOT excluding .tfvars: SecureFin tfvars contain only environment
# names, locations, and non-sensitive defaults — no secrets. Credentials
# are handled via OIDC (zero secrets). tfvars MUST be committed so the
# CI/CD pipeline can reference them.

# ---------------------------------------------------------------------------
# OS generated files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# IDE / Editor
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# PowerShell / Scripts
# ---------------------------------------------------------------------------
*.ps1xml
